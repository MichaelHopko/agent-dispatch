#!/usr/bin/env bash
source "$(dirname "${BASH_SOURCE[0]}")/usage.sh" || { return 1 2>/dev/null || exit 1; }
_ar_fetch_remaining_json() {
  local vendor="$1"
  AGENT_RUNTIME_REMAINING_VENDOR="$vendor" python3 - <<'PY'
import json, os, ssl, sys, urllib.error, urllib.request
from pathlib import Path

vendor = os.environ["AGENT_RUNTIME_REMAINING_VENDOR"]
home = Path.home()
try:
    if vendor == "codex":
        auth = json.loads((home / ".codex" / "auth.json").read_text())
        tokens = auth.get("tokens") or {}
        token = tokens.get("access_token")
        if not token:
            raise RuntimeError("no access_token")
        headers = {
            "Authorization": "Bearer " + token,
            "Accept": "application/json",
            "User-Agent": "codex-cli/0.147.0",
        }
        account = tokens.get("account_id")
        if account:
            headers["ChatGPT-Account-Id"] = account
        req = urllib.request.Request(
            "https://chatgpt.com/backend-api/wham/usage", headers=headers
        )
    elif vendor == "cursor":
        auth = json.loads((home / ".config" / "cursor" / "auth.json").read_text())
        token = auth.get("accessToken")
        if not token:
            raise RuntimeError("no accessToken")
        req = urllib.request.Request(
            "https://api2.cursor.sh/aiserver.v1.DashboardService/GetCurrentPeriodUsage",
            data=b"{}",
            headers={
                "Authorization": "Bearer " + token,
                "Accept": "application/json",
                "Content-Type": "application/json",
            },
            method="POST",
        )
    elif vendor == "grok":
        grok_home = Path(os.environ.get("GROK_HOME") or (home / ".grok"))
        auth = json.loads((grok_home / "auth.json").read_text())
        if not isinstance(auth, dict):
            raise RuntimeError("no grok auth")
        entry = None
        for key, value in auth.items():
            if not isinstance(value, dict) or not value.get("key"):
                continue
            if str(key).startswith("https://auth.x.ai"):
                entry = value
                break
            if entry is None:
                entry = value
        token = (entry or {}).get("key")
        if not token:
            raise RuntimeError("no grok key")
        req = urllib.request.Request(
            "https://cli-chat-proxy.grok.com/v1/billing?format=credits",
            headers={
                "Authorization": "Bearer " + token,
                "Accept": "application/json",
                "x-xai-token-auth": "xai-grok-cli",
            },
        )
    else:
        raise RuntimeError("no remaining endpoint")
    with urllib.request.urlopen(req, timeout=20, context=ssl.create_default_context()) as resp:
        sys.stdout.buffer.write(resp.read())
except Exception:
    sys.exit(1)
PY
}

_ar_timeout() {
  if command -v timeout >/dev/null 2>&1; then
    timeout 25 "$@"
  else
    "$@"
  fi
}

# Live remaining-or-UNKNOWN for one runtime. Only calls endpoints that exist.
# AGENT_RUNTIME_REMAINING_STUB[_<rt>] sets the response for offline tests.
agent_runtime_remaining() {
  local rt="${1:-}" out stub_var stub
  stub_var="AGENT_RUNTIME_REMAINING_STUB_${rt//[^[:alnum:]_]/_}"
  stub="${!stub_var-}"
  if [ -n "$stub" ]; then
    echo "$stub"
    return 0
  fi
  if [ -n "${AGENT_RUNTIME_REMAINING_STUB:-}" ]; then
    echo "$AGENT_RUNTIME_REMAINING_STUB"
    return 0
  fi
  case "$rt" in
    claude)
      out="$(_ar_timeout claude /usage </dev/null 2>&1)" || true
      agent_runtime_parse_claude_usage "$out"
      ;;
    codex)
      out="$(_ar_fetch_remaining_json codex)" || { echo UNKNOWN; return 0; }
      agent_runtime_parse_codex_wham "$out"
      ;;
    cursor)
      out="$(_ar_fetch_remaining_json cursor)" || { echo UNKNOWN; return 0; }
      agent_runtime_parse_cursor_period "$out"
      ;;
    grok)
      out="$(_ar_fetch_remaining_json grok)" || { echo UNKNOWN; return 0; }
      agent_runtime_parse_grok_billing "$out"
      ;;
    *)
      echo UNKNOWN
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  agent_runtime_remaining "$1"
fi
